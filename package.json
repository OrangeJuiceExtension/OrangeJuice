{
	"name": "orangejuice",
	"description": "Orange Juice makes HackerNews sweeter",
	"private": true,
	"version": "0.33.0",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build-watch": "chokidar --initial --silent \"src/**/*\" -c \"bun run build\"",
		"build:firefox": "wxt build -b firefox",
		"build:safari": "wxt build -b safari --mv3",
		"build:safari:convert": "bun run build:safari && ./scripts/safari.sh",
		"webext:firefox:lint": "web-ext -w -s .output/firefox-mv2/ lint",
		"icons": "bun run scripts/generate-icons.ts",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare",
		"test": "vitest",
		"ci": "CI=true bun run --parallel check test build build:firefox && bun run webext:firefox:lint && bun run clean && CI=true bun run --parallel zip zip:firefox",
		"check": "bun ./node_modules/ultracite/dist/index.js check",
		"fix": "bun ./node_modules/ultracite/dist/index.js fix",
		"prepare": "lefthook install",
		"clean": "rm -rf .output build-docs playwright-report"
	},
	"dependencies": {
		"@wxt-dev/storage": "^1.2.8",
		"beautiful-mermaid": "^1.1.3",
		"comctx": "^1.7.5",
		"fit-textarea": "^3.0.0",
		"hast-util-from-html": "^2.0.3",
		"hast-util-sanitize": "^5.0.2",
		"linkify-html": "^4.3.3",
		"linkifyjs": "^4.3.3",
		"node-emoji": "^2.2.0",
		"property-information": "^7.2.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwindcss": "^4.3.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.3.2",
		"@testing-library/dom": "^10.4.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@wxt-dev/browser": "^0.2.2",
		"@wxt-dev/module-react": "^1.2.2",
		"chokidar-cli": "^3.0.0",
		"globals": "^17.7.0",
		"happy-dom": "^20.10.6",
		"lefthook": "^2.1.10",
		"oxipng": "^1.0.1",
		"playwright": "^1.61.1",
		"postcss": "^8.5.16",
		"postcss-preset-env": "^11.3.2",
		"sharp": "^0.35.3",
		"typescript": "^7.0.2",
		"typescript-language-server-tsserver": "npm:typescript@^6.0.3",
		"ultracite": "7.9.3",
		"vitest": "^4.1.10",
		"vitest-localstorage-mock": "^0.1.2",
		"web-ext": "^10.4.0",
		"wxt": "^0.20.27"
	}
}
