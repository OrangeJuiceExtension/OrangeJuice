{
	"name": "orangejuice",
	"version": "0.35.0",
	"private": true,
	"description": "Orange Juice makes HackerNews sweeter",
	"type": "module",
	"scripts": {
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"build:safari": "wxt build -b safari --mv3",
		"build:safari:convert": "bun run build:safari && ./scripts/safari.sh",
		"build-watch": "chokidar --initial --silent \"src/**/*\" -c \"bun run build\"",
		"check": "bun ./node_modules/ultracite/dist/index.js check",
		"ci": "CI=true bun run --parallel check compile test build build:firefox && bun run webext:firefox:lint && bun run clean && CI=true bun run --parallel zip zip:firefox",
		"clean": "rm -rf .output build-docs playwright-report",
		"compile": "tsc --noEmit",
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"dev:manual": "OJ_MANUAL_BROWSER=1 wxt",
		"fix": "bun ./node_modules/ultracite/dist/index.js fix",
		"icons": "bun run scripts/generate-icons.ts",
		"postinstall": "wxt prepare",
		"prepare": "lefthook install",
		"social-images": "bun run scripts/generate-og-image.ts",
		"test": "vitest",
		"webext:firefox:lint": "web-ext -w -s .output/firefox-mv2/ lint",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox"
	},
	"dependencies": {
		"@wxt-dev/storage": "^1.2.9",
		"beautiful-mermaid": "^1.1.3",
		"comctx": "^1.7.5",
		"fit-textarea": "^3.0.0",
		"hast-util-from-html": "^2.0.3",
		"hast-util-sanitize": "^5.0.2",
		"linkify-html": "^4.3.3",
		"linkifyjs": "^4.3.3",
		"node-emoji": "^2.2.0",
		"property-information": "^7.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wxt-dev/browser": "^0.3.4",
		"@wxt-dev/module-react": "^1.2.2",
		"chokidar-cli": "^3.0.0",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.5",
		"lefthook": "^2.1.16",
		"oxipng": "^1.0.1",
		"playwright": "^1.63.0",
		"postcss": "^8.5.28",
		"postcss-preset-env": "^11.6.0",
		"publish-browser-extension": "6.1.1",
		"sharp": "^0.35.5",
		"typescript": "^7.0.2",
		"ultracite": "7.12.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"web-ext": "^10.7.0",
		"wxt": "^0.21.4"
	},
	"packageManager": "bun@1.4.2"
}
